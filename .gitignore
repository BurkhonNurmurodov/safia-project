# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
build/
.eggs/
venv/
env/
.venv/
*.pyc

# ── Node / Frontend ─────────────────────────────────────
# No trailing slash: a cloud session SYMLINKS frontend/node_modules in from
# /opt, a symlink is a file to git, and `node_modules/` matches directories only
# — so the old spelling let `git add -A` commit the link and ship it to prod.
node_modules
frontend/dist-ssr/
frontend/build/
*.local

# ── Environment / Secrets ───────────────────────────────
.env
.env.*
!.env.example
backend/.env
frontend/.env
bot/.env
# cPanel's File Manager downloads .env copies under names like
# "cPanel File Manager.uu" — a verbatim copy of the PRODUCTION env
# (live DB password, bot token, Notion token). Never let one in.
*.uu
cPanel*

# ── JSON: ignored wholesale, with a short allow-list ────
# The Google service-account key must NEVER be re-included here.
*.json
!package.json
!package-lock.json
!tsconfig.json
!jsconfig.json
!eslint.config.json
# The build's deploy marker — emitted into the tracked dist and FETCHED AT
# RUNTIME by the running app to detect a newer build. Ignored, it never ships
# and the update prompt goes permanently silent. Exact path, not a glob.
!frontend/dist/build.json

# The cloud-session hooks. Committed ON PURPOSE: a cloud session gets only what
# the repo carries, so an ignored settings.json means neither the hook that
# provisions the VM nor the Stop hook that commits, builds and deploys (the
# laptop's loop, `auto-commit.sh cloud`) ever runs there. Both are no-ops
# unless CLAUDE_CODE_REMOTE=true. .claude/settings.local.json stays ignored —
# it is the laptop's own copy of that loop. .claude/launch.json stays ignored
# too: it names an absolute per-machine python, and scripts/cloud-setup.sh
# writes the cloud's own copy.
!.claude/settings.json
# Defence in depth: these stay ignored even if *.json is ever relaxed.
safia-project-*.json
*service-account*.json
*credentials*.json

# ── Keys / certificates ─────────────────────────────────
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# ── Logs ────────────────────────────────────────────────
*.log
logs/
*.log.*

# ── OS / Editor ─────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.sw?

# ── Database dumps / backups ────────────────────────────
# The admin panel writes full production dumps here; they carry staff PII
# and live registration tokens, and git would keep them forever.
*.sql
*.sql.gz
*.dump
*.bak
*.sqlite
*.sqlite3
*.db

# ── Archives ────────────────────────────────────────────
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# ── Misc project artifacts ──────────────────────────────
backend.zip
verifix_data.json
verifix_data.xlsx
verifix_run.log
zi47WZ0K
frontend/dist.tar.gz
frontend/dist.zip

