<?xml version="1.0" encoding="utf-8"?>
<!--
    Safia IMS for Android (CLAUDE.md, «The Android app»): the site's pages,
    built into the APK, in the app's own web view — no Chrome. MainActivity
    serves the pages from assets/web (WebBundle) at the production address,
    and only the data (/api and the other server paths) goes over the network.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The proof camera (getUserMedia on /proof/camera). Asked for only when a
         page of the site asks for the camera, never at install or launch. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- The app's own updates (AppUpdates): the published APK is handed to
         Android's installer, which asks the person to confirm. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Phone notifications (Push): Android 13+ asks the person once; the
         background check (PushJob) survives a restart of the phone. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ package visibility: which app is the phone's browser — the
         one place a page of ours must open outside the app, and the failure
         report's device line. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".SafiaApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/appName"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Safia">

        <meta-data
            android:name="asset_statements"
            android:resource="@string/assetStatements" />

        <!-- singleTask: the launcher icon returns to the page where the person
             was, and a production link from another app opens in this same one.
             configChanges: rotating or folding the phone must not reload the page. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true"
            android:label="@string/launcherName"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A production link tapped in another app opens here, once Android
                 has checked /.well-known/assetlinks.json (backend/app/main.py). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="production.safiacorporate.uz"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- The admin's «open as this profile»: a second session on a screen of
             its own, on top of the first (SessionActivity). Standard launch, so
             it stacks in this task and back returns to the admin's own screen;
             never started from outside the app. -->
        <activity
            android:name=".SessionActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- The background check for notifications, run by Android's job
             scheduler about every 15 minutes (Push.schedule). -->
        <service
            android:name=".PushJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Files FileHandoff hands to other apps (an opened photo, a download on
             Android 7–9). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
