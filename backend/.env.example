DATABASE_URL=postgresql://user:password@localhost:5432/zagruzka_db
GOOGLE_CREDENTIALS_FILE=../safia-project-bea00b0b2514.json
SECRET_KEY=change-this-secret-key-in-production

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
ADMIN_TELEGRAM_ID=123456789

# Frontend URL (used by bot for WebApp buttons)
WEBAPP_URL=https://your-domain.com

# Notion (Kaizen project analytics page). Internal-integration token from
# https://www.notion.so/my-integrations . Share the Kaizen hub page with the
# integration so it can read all eight inline databases. Leave blank to disable.
NOTION_TOKEN=

# ARC service-ticket API (page /arc). Login for
# https://api.dashboard.service.safiabakery.uz — either name is blank → the
# integration is off (page says «not connected», no sync jobs). Deliverable
# without SSH via Gitea secrets (deploy/sync-env.sh). The bare USERNAME= /
# PASSWORD= names IT used are also read — including the PASSAWORD= misspelling
# that is what actually sits on prod; the ARC_ ones win when several exist.
ARC_USERNAME=
ARC_PASSWORD=
