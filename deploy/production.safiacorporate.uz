# nginx site for production.safiacorporate.uz — Safia Production dashboard.
#
# Everything is proxied to the FastAPI app on 127.0.0.1:8030: the backend serves
# the built React SPA itself (app.main mounts /assets and falls back to
# index.html), exactly as Passenger did on the old cPanel host. Proxying the lot
# means no nginx location can accidentally swallow a backend route — this app
# owns /api, /admin, /bot/webhook, /assets and bare static files at the
# document root, and the SPA has its own /admin/* routes on top.
#
#   sudo cp /var/www/production/deploy/production.safiacorporate.uz /etc/nginx/sites-available/
#   sudo ln -sfn /etc/nginx/sites-available/production.safiacorporate.uz \
#                /etc/nginx/sites-enabled/production.safiacorporate.uz
#   sudo nginx -t && sudo systemctl reload nginx
#
# Certificate — webroot plugin; certbot --nginx is unusable on this host
# (another vhost carries a 1024-bit RSA key and it aborts):
#   sudo certbot certonly --webroot -w /var/www/letsencrypt -d production.safiacorporate.uz
#
# BLUE-GREEN (deploy/03-bluegreen-setup.sh installs this version): the app runs
# as two copies, safia-production@8030 and @8031, and a deploy starts the new
# one before stopping the old one. Both ports are in the upstream; whichever is
# down is skipped (connection refused → next server), so a swap needs no nginx
# reload. If NEITHER answers (a crash, or the single-copy restart this replaced),
# nginx serves the app's page files itself from frontend/dist and answers the
# API with a JSON 503 marked `X-Safia-Restarting: 1`, which the app waits out
# (frontend/src/utils/serverRestart.js) instead of showing an error page.
#
# Behind Cloudflare in "Full" mode. Port 80 and 443 both answer and both serve
# the ACME challenge, so renewal works whichever port Cloudflare reaches.

# max_fails=0: never "rest" a copy after a failure. A stopped copy refuses the
# connection instantly on localhost, so asking it every time costs nothing —
# while the default (1 failure → skipped for 10 s) left the copy that had just
# come up marked dead in the very seconds the old one was stopping, and every
# request in that window got "no live upstreams".
upstream safia_production {
    server 127.0.0.1:8030 max_fails=0;
    server 127.0.0.1:8031 max_fails=0;
}

# Paths only the backend can answer. When no copy is up these get the JSON 503,
# never the SPA's index.html: an HTML body on /api is read by the app as the
# hosting anti-bot page. /admin/upload is the SPA's own page (listed FIRST —
# regexes are tried in order), every other /admin/... is a backend route.
map $uri $safia_backend_only {
    default                     0;
    ~^/admin/upload/?$          0;
    ~^/admin/                   1;
    ~^/api/                     1;
    ~^/bot/                     1;
    ~^/health                   1;
    ~^/docs                     1;
    ~^/openapi\.json            1;
}

server {
    listen 80;
    listen [::]:80;
    server_name production.safiacorporate.uz;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / { return 301 https://$host$request_uri; }
}

server {
    # nginx 1.18 (Ubuntu) uses the http2 listen parameter, not "http2 on;"
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name production.safiacorporate.uz;

    ssl_certificate     /etc/letsencrypt/live/production.safiacorporate.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/production.safiacorporate.uz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Keep API explorers closed before the SPA fallback can answer their paths.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    location ~ ^/(docs|redoc|openapi\.json)(/|$) { return 404; }

    # Uploads are large: verifix .xlsx batches, production catalogs, broadcast
    # media — and /admin/db-restore accepts a multi-part database dump the admin
    # UI documents as "~400 MB compressed". The nginx default is 1 MB.
    client_max_body_size 512m;
    client_body_timeout 300s;

    # gzip_proxied is the important part: without it nginx refuses to compress
    # upstream responses, and since EVERYTHING here comes from uvicorn (which has
    # no GZipMiddleware) a cold load would ship ~975 KB uncompressed to a mobile
    # Telegram WebView.
    gzip on;
    gzip_proxied any;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;
    gzip_min_length 1024;

    access_log /var/log/nginx/production.safiacorporate.uz.access.log;
    error_log  /var/log/nginx/production.safiacorporate.uz.error.log;

    # Also on 443, so ACME renewal works even when Cloudflare reaches the origin
    # over HTTPS (its "Always Use HTTPS" rule rewrites the challenge URL).
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        proxy_pass http://safia_production;
        # A copy that is down refuses the connection instantly; try the other.
        # Only `error` (connect/send/read-header failures) — never `timeout`,
        # which would run a slow export a second time. nginx never repeats a
        # POST that already reached a copy.
        proxy_next_upstream error;
        proxy_connect_timeout 3s;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "";
        # Excel exports and the heavier analytics endpoints are slow.
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        # Stream large uploads straight through instead of spooling the whole
        # body to disk first (matters for the multi-hundred-MB db-restore POST).
        proxy_request_buffering off;
        # Leave proxy_intercept_errors at its default (off) on purpose: the SPA's
        # api.js treats an HTML body on an /api URL as an anti-bot challenge and
        # force-reloads the page after two retries, so an nginx HTML error page
        # in front of a JSON endpoint would put clients in a reload loop.
        # error_page below therefore only catches what NGINX itself produces —
        # no copy answering at all — never an error the app returned.
        error_page 502 504 = @safia_offline;
    }

    # No copy is answering. Keep the app itself on screen: its page files come
    # straight from disk, and the API answers a marked JSON 503 that the app
    # retries quietly until a copy is back.
    location @safia_offline {
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cache-Control "no-store" always;
        add_header X-Safia-Restarting "1" always;
        default_type application/json;
        if ($safia_backend_only) {
            return 503 '{"detail":"The server is restarting — try again in a few seconds."}';
        }
        root /var/www/production/frontend/dist;
        try_files $uri /__safia_offline_index.html;
    }

    # The SPA shell for the fallback above — a location of its own, so the
    # internal redirect lands on a file and never back on the proxy.
    location = /__safia_offline_index.html {
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        internal;
        add_header Cache-Control "no-store" always;
        add_header X-Safia-Restarting "1" always;
        root /var/www/production/frontend/dist;
        try_files /index.html =503;
    }
}
