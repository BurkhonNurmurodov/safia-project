{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/cloud-setup.sh",
            "timeout": 180,
            "statusMessage": "Preparing the cloud session..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/auto-commit.sh cloud",
            "timeout": 420,
            "statusMessage": "Building, committing and deploying..."
          }
        ]
      }
    ]
  }
}
